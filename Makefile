# FIM2: Kria K26 build flow. Run `make help` for the target list.
#
# Run every target from a plain terminal. Each target sets up the
# environment it needs and keeps the others out:
#   Vivado  sources VIVADO_SETTINGS (set it in local.mk, see local.mk.example)
#   Yocto   sources build/edf/edf-init-build-env build/yocto, in a clean env
# Without VIVADO_SETTINGS, source Vivado's settings64.sh yourself first.
#
# A build is one SOM + carrier combination: make CARRIER=<name> <target>.
#   carriers/<name>/    block design, device tree, part and machine for one combo
#   som/k26/            device tree for what is on the SOM itself, shared
#   hdl/<module>/       reusable HDL, loaded into every carrier's project
#   sw/                 shared by every carrier
# The logic lives in scripts/; this file only wires stages together.

include project.mk
ifeq ($(wildcard carriers/$(CARRIER)/carrier.mk),)
$(error Unknown CARRIER '$(CARRIER)'; choose one of: $(notdir $(wildcard carriers/*)))
endif
include carriers/$(CARRIER)/carrier.mk
# Per-host settings such as VIVADO_SETTINGS; not in git.
-include local.mk
# Yocto machine, generated by make machine from this carrier's SDT.
MACHINE := $(SOM)-$(CARRIER)-sdt

# ---- Tools: override on the command line, e.g. make VIVADO=/path/to/vivado
VIVADO           ?= vivado
SDTGEN           ?= sdtgen
DTC              ?= dtc
DTS_CPP          ?= cpp
XSDB             ?= xsdb
BOOTGEN          ?= bootgen
REPO             ?= repo
BITBAKE          ?= bitbake
GEN_MACHINE_CONF ?= gen-machine-conf

# Vivado's settings64.sh, sourced for Vivado targets when set
VIVADO_SETTINGS  ?=

# ---- Options
SYNC_JOBS        ?= 4
# Parallel Vivado runs for make bit
VIVADO_JOBS      ?= 4
# Disk image recipe built by make image
IMAGE_RECIPE     ?= edf-linux-disk-image
# Set empty on hosts that do not need the namespace-enabled AppArmor profile.
APPARMOR_PROFILE ?= bitbake
# Flashing: IMAGE=path (default: this carrier's latest build),
# DRY_RUN=1 prints the command only, HW_SERVER=host
IMAGE            ?=
DRY_RUN          ?= 0
HW_SERVER        ?=
# FORCE=1 overrides the block design guards of xsa and bd-export.
FORCE            ?= 0

# ---- Sources and outputs
CARRIER_DIR := carriers/$(CARRIER)
# Block design name; carrier.mk sets BD_NAME when the carrier's own name
# would clash with an HDL entity.
BD_NAME     ?= $(CARRIER)
BD_TCL      := $(CARRIER_DIR)/bd/$(BD_NAME).tcl
# Shared modules and optional carrier-specific HDL. Carrier configuration can
# override HDL_SOURCES with an explicit list if it needs a different selection.
HDL_DIRS    := $(wildcard hdl/ hdl/*/ $(CARRIER_DIR)/hdl/)
HDL_SOURCES ?= $(sort $(foreach dir,$(HDL_DIRS),$(wildcard $(addprefix $(dir),*.vhd *.vhdl *.v *.sv))))
# Carriers with PL logic set TOP (their hand-written top level) and
# XDC_SOURCES in carrier.mk. Without TOP the block design's generated wrapper
# is the top and there is no bitstream (PS only).
TOP         ?=
XDC_SOURCES ?=
BUILD       := build
OUT         := $(BUILD)/$(CARRIER)
LOGS        := $(OUT)/logs
XSA         := $(OUT)/$(CARRIER).xsa
BIT         := $(OUT)/$(CARRIER).bit
SDT         := $(OUT)/sdt/.generated
# Vivado project, rebuilt from BD_TCL by make xsa and opened by make gui.
PROJECT     := $(OUT)/vivado/$(CARRIER).xpr
PROJECT_BD  := $(OUT)/vivado/$(CARRIER).srcs/sources_1/bd/$(BD_NAME)/$(BD_NAME).bd
# Touched whenever the project and BD_TCL match (after xsa and bd-export).
BD_SYNCED   := $(OUT)/vivado/.bd-synced
FLASH_TOOL  := $(BUILD)/tools/amd-flash-v8.0/.ready
DEPLOY      := $(BUILD)/yocto/tmp/deploy/images/$(MACHINE)
YOCTO_ENV   := $(BUILD)/edf/edf-init-build-env

# $(IN_VIVADO) cmd...: run cmd with Vivado's settings (if VIVADO_SETTINGS is
# set) and without the Yocto environment.
IN_VIVADO = env -u BUILDDIR bash -c '[ -z "$$1" ] || . "$$1" >/dev/null || exit; shift; exec "$$@"' _ "$(VIVADO_SETTINGS)"
# $(IN_YOCTO) cmd...: run cmd from the repository in a clean environment with
# the Yocto build environment sourced, so Vivado's tools cannot leak in.
IN_YOCTO = env -i HOME="$$HOME" USER="$$USER" LANG="$${LANG:-C.UTF-8}" TERM="$${TERM:-dumb}" \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    $(foreach v,http_proxy https_proxy no_proxy DL_DIR SSTATE_DIR,$(if $($(v)),$(v)="$($(v))")) \
    bash -c '. "$$1/$(YOCTO_ENV)" "$$1/$(BUILD)/yocto" >/dev/null && cd "$$1" && shift && exec "$$@"' _ "$(CURDIR)"
# Ubuntu 24.04 blocks BitBake's user namespaces without this profile.
AA_EXEC = $(if $(APPARMOR_PROFILE),aa-exec -p $(APPARMOR_PROFILE) --)

# $(call require,VAR,hint): fail early if the tool named by $(VAR) is missing
# (looked up with Vivado's settings, where most of them come from).
require = @$(IN_VIVADO) sh -c 'command -v "$$1"' _ "$($(1))" >/dev/null 2>&1 || { echo "$(1)=$($(1)) not found. $(2)" >&2; exit 1; }

.DEFAULT_GOAL := help
.DELETE_ON_ERROR:
.PHONY: help config xsa bit sdt gui bd-export setup machine boot image flash-tool flash-qspi flash-emmc clean

##@ General

help: ## Show this list
	@awk 'BEGIN { FS = ":.*## " } \
	    /^##@/ { printf "\n%s\n", substr($$0, 5) } \
	    /^[a-z][a-z-]*:.*## / { printf "  %-12s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)
	@echo
	@echo "Carrier: $(CARRIER)    (make CARRIER=<name>; carriers: $(notdir $(wildcard carriers/*)))"
	@echo

config: ## Show the resolved carrier and tool settings
	@printf '%-12s %s\n' CARRIER "$(CARRIER)" SOM "$(SOM)" PART "$(PART)" \
	    BOARD_PART "$(BOARD_PART)" HAS_EMMC "$(HAS_EMMC)" MACHINE "$(MACHINE)" \
	    BD_NAME "$(BD_NAME)" TOP "$(or $(TOP),(none: PS only))" \
	    TOOL_VERSION "$(TOOL_VERSION)" EDF_RELEASE "$(EDF_RELEASE)" OUT "$(OUT)" DTSI "$(DTSI)"

##@ Hardware (Vivado)

xsa: $(XSA) ## Export hardware handoff to build/<carrier>/<carrier>.xsa
bit: $(BIT) ## Build the PL bitstream: build/<carrier>/<carrier>.bit and .bit.bin
sdt: $(SDT) ## Generate system device tree in build/<carrier>/sdt

# Block design edits: make gui, edit and save, make bd-export, commit BD_TCL.
# The project in build/ is disposable; BD_TCL in git is the source.
gui: $(XSA) ## Open the carrier's Vivado project in the GUI
	cd $(OUT) && nohup $(IN_VIVADO) "$(VIVADO)" -mode gui -log logs/gui.log -journal logs/gui.jou \
	    vivado/$(CARRIER).xpr >/dev/null 2>&1 &
	@echo "Vivado is starting on $(PROJECT). After saving edits: make CARRIER=$(CARRIER) bd-export"

bd-export: ## Write the saved GUI block design back to carriers/<carrier>/bd
	$(call require,VIVADO,Source Vivado $(TOOL_VERSION) settings64.sh or set VIVADO=/path/to/vivado.)
	@test -f $(PROJECT) || { echo "No project at $(PROJECT); run make gui first." >&2; exit 1; }
	@if [ "$(FORCE)" != 1 ] && [ $(BD_TCL) -nt $(BD_SYNCED) ]; then \
	    echo "$(BD_TCL) changed after the project was built; exporting would overwrite it." >&2; \
	    echo "Rebuild with make xsa, or keep the project's design with FORCE=1." >&2; exit 1; fi
	@mkdir -p $(LOGS)
	cd $(OUT) && $(IN_VIVADO) "$(VIVADO)" -mode batch -notrace -log logs/bd-export.log -journal logs/bd-export.jou \
	    -source $(CURDIR)/scripts/vivado/export_bd.tcl -tclargs $(CURDIR)/$(PROJECT) $(CURDIR)/$(BD_TCL)
	@git --no-pager diff --stat -- $(BD_TCL)

$(XSA): $(BD_TCL) $(HDL_SOURCES) $(XDC_SOURCES) $(HDL_DIRS) Makefile scripts/vivado/export_xsa.tcl project.mk $(CARRIER_DIR)/carrier.mk
	$(call require,VIVADO,Source Vivado $(TOOL_VERSION) settings64.sh or set VIVADO=/path/to/vivado.)
	@if [ "$(FORCE)" != 1 ] && [ -f $(PROJECT_BD) ] && [ $(PROJECT_BD) -nt $(BD_SYNCED) ]; then \
	    echo "The block design in $(PROJECT) has edits not exported to $(BD_TCL)." >&2; \
	    echo "Run make bd-export first, or discard them with FORCE=1." >&2; exit 1; fi
	@mkdir -p $(LOGS)
	cd $(OUT) && $(IN_VIVADO) "$(VIVADO)" -mode batch -notrace -log logs/vivado.log -journal logs/vivado.jou \
	    -source $(CURDIR)/scripts/vivado/export_xsa.tcl \
	    -tclargs $(PART) $(BOARD_PART) $(TOOL_VERSION) $(CURDIR)/$(BD_TCL) $(CURDIR)/$(XSA) "$(TOP)" \
	    $(foreach source,$(HDL_SOURCES) $(XDC_SOURCES),"$(abspath $(source))")
	@test -s $@ || { echo "Vivado did not produce $@" >&2; exit 1; }

# Synthesis and implementation run in the project make xsa created, so
# make gui shows the same runs and reports. <carrier>.bit is for JTAG;
# <carrier>.bit.bin is for the Linux FPGA manager, which (unlike JTAG with a
# bitstream-less BOOT.BIN) also opens the PS-PL interfaces and resets the PL.
$(BIT): $(XSA) scripts/vivado/build_bit.tcl
	@test -n "$(TOP)" || { echo "Carrier $(CARRIER) has no PL logic (no TOP in carrier.mk)." >&2; exit 1; }
	cd $(OUT) && $(IN_VIVADO) "$(VIVADO)" -mode batch -notrace -log logs/bit.log -journal logs/bit.jou \
	    -source $(CURDIR)/scripts/vivado/build_bit.tcl -tclargs $(CURDIR)/$(PROJECT) $(CURDIR)/$@ $(VIVADO_JOBS)
	@test -s $@ || { echo "Vivado did not produce $@" >&2; exit 1; }
	cd $(OUT) && printf 'all:\n{\n\t%s\n}\n' $(CARRIER).bit > $(CARRIER).bif && \
	    $(IN_VIVADO) "$(BOOTGEN)" -arch zynqmp -image $(CARRIER).bif -process_bitstream bin -w on > logs/bootgen.log
	@test -s $@.bin || { echo "bootgen did not produce $@.bin" >&2; exit 1; }

$(SDT): $(XSA) $(DTSI) scripts/generate_sdt.sh
	$(IN_VIVADO) bash scripts/generate_sdt.sh "$(XSA)" "$(SDTGEN)" "$(DTC)" "$(DTS_CPP)" $(DTSI)

##@ Software (Yocto)

setup: ## Fetch pinned EDF sources; create build/yocto from meta-alba-kria
	env -u BUILDDIR bash scripts/setup_edf.sh "$(CURDIR)" "$(REPO)" "$(SYNC_JOBS)" "$(EDF_RELEASE)"

machine: ## Generate the Yocto machine conf from the SDT
	$(IN_YOCTO) $(AA_EXEC) bash scripts/generate_machine.sh "$(CURDIR)" "$(GEN_MACHINE_CONF)" "$(MACHINE)" "$(TOOL_VERSION)" "$(CURDIR)/$(OUT)"

boot: ## Build BOOT.BIN (xilinx-bootbin)
	$(IN_YOCTO) bash scripts/build_yocto.sh "$(CURDIR)" "$(BITBAKE)" "$(MACHINE)" "$(APPARMOR_PROFILE)" xilinx-bootbin

image: ## Build the eMMC disk image (.wic.gz): IMAGE_RECIPE=edf-linux-disk-image
	$(IN_YOCTO) bash scripts/build_yocto.sh "$(CURDIR)" "$(BITBAKE)" "$(MACHINE)" "$(APPARMOR_PROFILE)" "$(IMAGE_RECIPE)"

##@ Programming (Vivado; DRY_RUN=1 never touches hardware)

flash-tool: $(FLASH_TOOL) ## Download and verify the AMD flash tool v8.0
flash-qspi: $(FLASH_TOOL) ## Write BOOT.BIN to QSPI (default: latest build)
	$(IN_VIVADO) bash scripts/flash.sh "$(CURDIR)" qspi "$(or $(IMAGE),$(DEPLOY)/BOOT-$(MACHINE).bin)" "$(XSDB)" "$(DRY_RUN)" "$(HW_SERVER)"
flash-emmc: $(FLASH_TOOL) ## Write the disk image to eMMC (default: latest build)
	@test "$(HAS_EMMC)" = 1 || { echo "Carrier $(CARRIER): its SOM has no eMMC." >&2; exit 1; }
	$(IN_VIVADO) bash scripts/flash.sh "$(CURDIR)" emmc "$(or $(IMAGE),$(DEPLOY)/$(IMAGE_RECIPE)-$(MACHINE).rootfs.wic.gz)" "$(XSDB)" "$(DRY_RUN)" "$(HW_SERVER)"

$(FLASH_TOOL): scripts/setup_flash_tool.sh
	bash scripts/setup_flash_tool.sh "$(CURDIR)"

##@ Housekeeping

clean: ## Remove this carrier's build/<carrier> (keeps EDF, Yocto and tools)
	rm -rf $(OUT)
